generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Vehicle {
  id                   String                @id @default(uuid())
  plate                String                @unique
  model                String
  brand                String
  year                 Int?
  fuelType             String?
  currentMileage       Int?
  status               VehicleStatus         @default(ACTIVE)
  documentExpiration   DateTime?
  insuranceExpiration  DateTime?
  modelVehicle         String?
  renavam              String?               @unique
  chassis              String?               @unique
  notes                String?
  driverId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deliveries           Delivery[]
  maintenanceOrders    MaintenanceOrder[]
  maintenanceSchedules MaintenanceSchedule[]
  documents            Document[]

  driver Driver? @relation(fields: [driverId], references: [id])

  @@map("vehicles")
}

model MaintenanceSchedule {
  id String @id @default(uuid())

  vehicleId String

  serviceName String

  description String?

  frequencyKm Int?

  frequencyDays Int?

  lastExecutionKm Int?

  nextExecutionKm Int?

  lastExecutionDate DateTime?

  nextExecutionDate DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  status MaintenanceScheduleStatus @default(ACTIVE)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("maintenance_schedules")
}

model User {
  id                  String            @id @default(uuid())
  name                String
  email               String            @unique
  active              Boolean           @default(true)
  passwordChangedAt   DateTime?
  avatarUrl           String?
  isOnline            Boolean           @default(false)
  lastSeenAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  passwordHash        String
  roleId              String
  failedLoginAttempts Int               @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean           @default(true)
  auditLogs           AuditLog[]
  devices             Device[]
  passwordHistory     PasswordHistory[]
  sales               Sale[]
  stockMovements      StockMovement[]
  sessions            UserSession[]
  documents           Document[]
  role                Role              @relation(fields: [roleId], references: [id])

  customers           Customer[]          @relation("SellerCustomers")
  approvedSales       Sale[]              @relation("ApprovedSales")
  approvedPurchases   PurchaseOrder[]     @relation("ApprovedPurchases")
  sellerDistributions StockDistribution[] @relation("SellerDistributions")
  distributedStock    StockDistribution[] @relation("DistributorUser")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid())
  module    String
  action    String
  createdAt DateTime         @default(now())
  roles     RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id             String    @id @default(uuid())
  userId         String
  token          String
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  tableName String
  recordId  String
  action    String
  oldData   Json?
  newData   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Device {
  id            String         @id @default(uuid())
  userId        String
  deviceName    String
  deviceCode    String         @unique
  platform      String?
  appVersion    String?
  active        Boolean        @default(true)
  lastSyncAt    DateTime?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])
  syncConflicts SyncConflict[]
  syncQueues    SyncQueue[]

  @@map("devices")
}

model Customer {
  id                    String                 @id @default(uuid())
  code                  String?                @unique
  type                  CustomerType           @default(COMPANY)
  name                  String
  cpfCnpj               String?                @unique
  ieRg                  String?
  phone                 String?
  mobile                String?
  email                 String?
  zipCode               String?
  address               String?
  number                String?
  complement            String?
  district              String?
  city                  String?
  state                 String?
  creditLimit           Decimal?
  notes                 String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialTransactions FinancialTransaction[]
  sales                 Sale[]
  documents             Document[]
  sellerId              String?

  seller User? @relation("SellerCustomers", fields: [sellerId], references: [id])

  @@map("customers")
}

model Supplier {
  id                    String                 @id @default(uuid())
  code                  String?                @unique
  companyName           String
  cpfCnpj               String?                @unique
  ieRg                  String?
  phone                 String?
  mobile                String?
  email                 String?
  zipCode               String?
  address               String?
  number                String?
  district              String?
  city                  String?
  state                 String?
  contactName           String?
  notes                 String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  financialTransactions FinancialTransaction[]
  maintenanceParts      MaintenancePart[]
  rawMaterials          RawMaterial[]
  purchaseOrders        PurchaseOrder[]
  documents             Document[]

  @@map("suppliers")
}

model PurchaseOrder {
  id String @id @default(uuid())

  number String @unique

  supplierId String

  status PurchaseStatus @default(DRAFT)

  totalAmount Decimal?

  notes String?

  approvedById String?

  approvedAt DateTime?

  expectedDelivery DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])

  approvedBy User? @relation("ApprovedPurchases", fields: [approvedById], references: [id])

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String

  rawMaterialId String?

  maintenancePartId String?

  quantity Decimal

  unitPrice Decimal

  totalPrice Decimal

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  maintenancePart MaintenancePart? @relation(fields: [maintenancePartId], references: [id])

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model RawMaterial {
  id                 String               @id @default(uuid())
  code               String               @unique
  description        String
  category           String?
  unit               String
  costPrice          Decimal
  minimumStock       Decimal
  currentStock       Decimal              @default(0)
  supplierId         String?
  active             Boolean              @default(true)
  imageUrl           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lots               RawMaterialLot[]
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  stockMovements     StockMovement[]
  formulaItems       ProductFormulaItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("raw_materials")
}

model RawMaterialLot {
  id             String      @id @default(uuid())
  rawMaterialId  String
  lotNumber      String
  expirationDate DateTime?
  quantity       Decimal
  createdAt      DateTime    @default(now())
  rawMaterial    RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@map("raw_material_lots")
}

model FinishedProduct {
  id                 String               @id @default(uuid())
  code               String               @unique
  description        String
  category           String?
  unit               String
  salePrice          Decimal
  productionCost     Decimal              @default(0)
  minimumStock       Decimal
  currentStock       Decimal              @default(0)
  imageUrl           String?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  lots               FinishedProductLot[]
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  stockDistributions StockDistribution[]
  formulas           ProductFormula[]     @relation("FormulaProduct")
  formulaItems       ProductFormulaItem[] @relation("FormulaComponentFinishedProduct")
  productionOrders   ProductionOrder[]

  @@map("finished_products")
}

model FinishedProductLot {
  id                String          @id @default(uuid())
  finishedProductId String
  lotNumber         String
  manufactureDate   DateTime?
  expirationDate    DateTime?
  quantity          Decimal
  createdAt         DateTime        @default(now())
  finishedProduct   FinishedProduct @relation(fields: [finishedProductId], references: [id])

  @@map("finished_product_lots")
}

model MaintenancePart {
  id                 String               @id @default(uuid())
  code               String               @unique
  description        String
  category           String?
  unit               String
  costPrice          Decimal
  minimumStock       Decimal
  currentStock       Decimal              @default(0)
  supplierId         String?
  active             Boolean              @default(true)
  imageUrl           String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  maintenanceItems   MaintenanceItem[]
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  formulaItems       ProductFormulaItem[]

  @@map("maintenance_parts")
}

model StockMovement {
  id                String           @id @default(uuid())
  stockType         StockType
  movementType      MovementType
  rawMaterialId     String?
  finishedProductId String?
  maintenancePartId String?
  quantity          Decimal
  unitCost          Decimal?
  totalCost         Decimal?
  balanceBefore     Decimal?
  balanceAfter      Decimal?
  referenceNumber   String?
  documentNumber    String?
  notes             String?
  userId            String?
  movementDate      DateTime         @default(now())
  createdAt         DateTime         @default(now())
  finishedProduct   FinishedProduct? @relation(fields: [finishedProductId], references: [id])
  maintenancePart   MaintenancePart? @relation(fields: [maintenancePartId], references: [id])
  rawMaterial       RawMaterial?     @relation(fields: [rawMaterialId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])

  @@map("stock_movements")
}

// model StockDistribution {
//   id String @id @default(uuid())

//   sellerId String

//   finishedProductId String

//   quantity Decimal

//   distributedAt DateTime @default(now())

//   distributedById String

//   notes String?
// }

model StockDistribution {
  id String @id @default(uuid())

  sellerId String

  finishedProductId String

  distributedById String

  quantity Decimal

  distributedAt DateTime @default(now())

  notes String?

  seller User @relation("SellerDistributions", fields: [sellerId], references: [id])

  distributedBy User @relation("DistributorUser", fields: [distributedById], references: [id])

  finishedProduct FinishedProduct @relation(fields: [finishedProductId], references: [id])

  @@map("stock_distributions")
}

model Sale {
  id                    String                 @id @default(uuid())
  number                String                 @unique
  customerId            String
  sellerId              String
  subtotal              Decimal
  discount              Decimal                @default(0)
  totalAmount           Decimal
  status                SaleStatus             @default(PENDING)
  syncStatus            SyncStatus             @default(PENDING)
  notes                 String?
  approvedById          String?
  approvedAt            DateTime?
  saleDate              DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deliveries            Delivery[]
  financialTransactions FinancialTransaction[]
  items                 SaleItem[]
  payments              SalePayment[]
  approvedBy            User?                  @relation("ApprovedSales", fields: [approvedById], references: [id])
  customer              Customer               @relation(fields: [customerId], references: [id])
  seller                User                   @relation(fields: [sellerId], references: [id])

  @@map("sales")
}

model SaleItem {
  id                String          @id @default(uuid())
  saleId            String
  finishedProductId String
  quantity          Decimal
  unitPrice         Decimal
  totalPrice        Decimal
  createdAt         DateTime        @default(now())
  finishedProduct   FinishedProduct @relation(fields: [finishedProductId], references: [id])
  sale              Sale            @relation(fields: [saleId], references: [id])

  @@map("sale_items")
}

model SalePayment {
  id            String        @id @default(uuid())
  saleId        String
  paymentMethod PaymentMethod
  amount        Decimal
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id])

  @@map("sale_payments")
}

model CashRegister {
  id           String                 @id @default(uuid())
  name         String
  description  String?
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  transactions FinancialTransaction[]

  @@map("cash_registers")
}

model FinancialTransaction {
  id                String          @id @default(uuid())
  referenceNumber   String?
  description       String
  type              FinancialType
  status            FinancialStatus @default(OPEN)
  paymentMethod     PaymentMethod?
  amount            Decimal
  installmentNumber Int?
  totalInstallments Int?
  dueDate           DateTime
  paymentDate       DateTime?
  customerId        String?
  supplierId        String?
  saleId            String?
  cashRegisterId    String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cashRegister      CashRegister?   @relation(fields: [cashRegisterId], references: [id])
  customer          Customer?       @relation(fields: [customerId], references: [id])
  sale              Sale?           @relation(fields: [saleId], references: [id])
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])

  @@map("financial_transactions")
}

model Driver {
  id                String     @id @default(uuid())
  employeeName      String
  cpf               String?    @unique
  licenseNumber     String     @unique
  licenseCategory   String
  licenseExpiration DateTime?
  active            Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deliveries        Delivery[]
  vehicles          Vehicle[]
  documents         Document[]

  @@map("drivers")
}

model Route {
  id          String     @id @default(uuid())
  code        String     @unique
  description String
  city        String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deliveries  Delivery[]

  @@map("routes")
}

model Delivery {
  id            String         @id @default(uuid())
  saleId        String?
  vehicleId     String?
  driverId      String?
  routeId       String?
  status        DeliveryStatus @default(PENDING)
  departureDate DateTime?
  deliveryDate  DateTime?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  driver        Driver?        @relation(fields: [driverId], references: [id])
  route         Route?         @relation(fields: [routeId], references: [id])
  sale          Sale?          @relation(fields: [saleId], references: [id])
  vehicle       Vehicle?       @relation(fields: [vehicleId], references: [id])

  @@map("deliveries")
}

model Machine {
  id                         String                       @id @default(uuid())
  code                       String                       @unique
  name                       String
  model                      String?
  serialNumber               String?                      @unique
  manufacturer               String?
  location                   String?
  active                     Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  maintenanceOrders          MaintenanceOrder[]
  MachineMaintenanceSchedule MachineMaintenanceSchedule[]
  documents                  Document[]

  @@map("machines")
}

model MachineMaintenanceSchedule {
  id String @id @default(uuid())

  machineId String

  serviceName String

  description String?

  frequencyHours Int?

  frequencyDays Int?

  lastExecutionDate DateTime?

  nextExecutionDate DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  status MaintenanceScheduleStatus @default(ACTIVE)

  machine Machine @relation(fields: [machineId], references: [id])

  @@map("machine_maintenance_schedules")
}

model MaintenanceOrder {
  id              String               @id @default(uuid())
  number          String               @unique
  type            MaintenanceType
  status          MaintenanceStatus    @default(OPEN)
  machineId       String?
  vehicleId       String?
  description     String
  performedBy     String?
  approvedBy      String?
  estimatedCost   Decimal?
  actualCost      Decimal?
  downtimeMinutes Int?
  isScheduled     Boolean              @default(true)
  openedAt        DateTime             @default(now())
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  histories       MaintenanceHistory[]
  items           MaintenanceItem[]
  machine         Machine?             @relation(fields: [machineId], references: [id])
  vehicle         Vehicle?             @relation(fields: [vehicleId], references: [id])

  @@map("maintenance_orders")
}

model MaintenanceItem {
  id                 String           @id @default(uuid())
  maintenanceOrderId String
  maintenancePartId  String
  quantity           Decimal
  unitCost           Decimal?
  totalCost          Decimal?
  createdAt          DateTime         @default(now())
  maintenanceOrder   MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id])
  maintenancePart    MaintenancePart  @relation(fields: [maintenancePartId], references: [id])

  @@map("maintenance_items")
}

model MaintenanceHistory {
  id                 String           @id @default(uuid())
  maintenanceOrderId String
  description        String
  performedBy        String?
  servicePerformed   String?
  notes              String?
  createdAt          DateTime         @default(now())
  maintenanceOrder   MaintenanceOrder @relation(fields: [maintenanceOrderId], references: [id])

  @@map("maintenance_history")
}

model Document {
  id String @id @default(uuid())

  name String

  originalFileName String?

  fileName String

  fileUrl String

  mimeType String?

  fileSize Int?

  category DocumentCategory

  expirationDate DateTime?

  issuedAt DateTime?

  vehicleId String?

  driverId String?

  customerId String?

  supplierId String?

  machineId String?

  userId String?

  description String?

  active Boolean @default(true)

  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  driver Driver? @relation(fields: [driverId], references: [id])

  customer Customer? @relation(fields: [customerId], references: [id])

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  machine Machine? @relation(fields: [machineId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@map("documents")
}

model SyncQueue {
  id           String        @id @default(uuid())
  deviceId     String
  entity       String
  entityId     String
  operation    SyncOperation
  payload      Json
  status       SyncStatus    @default(PENDING)
  retryCount   Int           @default(0)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?
  device       Device        @relation(fields: [deviceId], references: [id])

  @@map("sync_queue")
}

model SyncConflict {
  id              String         @id @default(uuid())
  entity          String
  entityId        String
  deviceId        String
  localData       Json
  serverData      Json
  status          ConflictStatus @default(OPEN)
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
  device          Device         @relation(fields: [deviceId], references: [id])

  @@map("sync_conflicts")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@map("password_history")
}

model Notification {
  id String @id @default(uuid())

  title String

  message String

  type NotificationType

  status NotificationStatus @default(PENDING)

  priority NotificationPriority @default(MEDIUM)

  sourceKey String? @unique

  referenceTable String?

  referenceId String?

  dueDate DateTime?

  readAt DateTime?

  resolvedAt DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([type])
  @@index([referenceTable, referenceId])
  @@map("notifications")
}

model DashboardMetric {
  id            String   @id @default(uuid())
  metric        String
  referenceDate DateTime
  value         Decimal
  createdAt     DateTime @default(now())

  @@map("dashboard_metrics")
}

model KpiHistory {
  id            String   @id @default(uuid())
  indicator     String
  referenceDate DateTime
  value         Decimal
  createdAt     DateTime @default(now())

  @@map("kpi_history")
}

model ProductFormula {
  id String @id @default(uuid())

  finishedProductId String

  version Int @default(1)

  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finishedProduct FinishedProduct @relation("FormulaProduct", fields: [finishedProductId], references: [id])

  items ProductFormulaItem[] @relation("FormulaItems")

  productionOrders ProductionOrder[]

  @@unique([finishedProductId, version])
  @@map("product_formulas")
}

model ProductionOrder {
  id String @id @default(uuid())

  number String @unique

  finishedProductId String

  formulaId String

  createdById String?

  status ProductionStatus @default(DRAFT)

  plannedQuantity Decimal

  producedQuantity Decimal @default(0)

  lossQuantity Decimal @default(0)

  notes String?

  productionNotes String?

  startedAt DateTime?

  finishedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  finishedProduct FinishedProduct @relation(fields: [finishedProductId], references: [id])

  formula ProductFormula @relation(fields: [formulaId], references: [id])

  @@index([status])
  @@index([finishedProductId])
  @@index([createdAt])
  @@map("production_orders")
}

model ProductFormulaItem {
  id String @id @default(uuid())

  formulaId String

  componentType FormulaComponentType

  rawMaterialId     String?
  finishedProductId String?
  maintenancePartId String?

  quantity Decimal

  lossPercentage Decimal? @default(0)

  notes String?

  createdAt DateTime @default(now())

  formula ProductFormula @relation("FormulaItems", fields: [formulaId], references: [id])

  rawMaterial RawMaterial? @relation(fields: [rawMaterialId], references: [id])

  finishedProduct FinishedProduct? @relation("FormulaComponentFinishedProduct", fields: [finishedProductId], references: [id])

  maintenancePart MaintenancePart? @relation(fields: [maintenancePartId], references: [id])

  @@map("product_formula_items")
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  CONFLICT
  ERROR
}

enum SyncOperation {
  INSERT
  UPDATE
  DELETE
}

enum ConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum FinancialType {
  RECEIVABLE
  PAYABLE
}

enum FinancialStatus {
  OPEN
  PARTIAL
  PAID
  OVERDUE
  CANCELED
}

enum AccountType {
  CASH
  BANK
  PIX
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_SLIP
  BANK_TRANSFER
  CHECK
  STORE_CREDIT
}

enum SaleStatus {
  DRAFT
  PENDING
  APPROVED
  DELIVERED
  CANCELED
  WAITING_STOCK
  WAITING_APPROVAL
  SEPARATED
}

enum StockType {
  RAW_MATERIAL
  FINISHED_PRODUCT
  MAINTENANCE_PART
}

enum MovementType {
  ENTRY
  EXIT
  SALE
  PURCHASE
  PRODUCTION
  MAINTENANCE
  TRANSFER
  ADJUSTMENT
  INVENTORY
  LOSS
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum MaintenanceScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum NotificationType {
  VEHICLE_DOCUMENT
  VEHICLE_INSURANCE
  DRIVER_LICENSE
  MAINTENANCE
  FINANCIAL
  STOCK
  SYSTEM
  ORDER_WAITING_STOCK
  ORDER_WAITING_APPROVAL
}

enum PurchaseStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum DocumentCategory {
  USER
  DRIVER
  VEHICLE
  CUSTOMER
  SUPPLIER
  MACHINE
  PRODUCT
  CONTRACT
  INSURANCE
  LICENSE
  CERTIFICATE
  MANUAL
  OTHER
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  READ
  RESOLVED
}

enum FormulaComponentType {
  RAW_MATERIAL
  // SEMI_FINISHED
  FINISHED_PRODUCT
  MAINTENANCE_PART
}

enum ProductionStatus {
